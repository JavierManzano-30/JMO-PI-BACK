PORT=3000
NODE_ENV=development
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/proyecto
JWT_SECRET=replace_with_32_plus_random_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://snapnation.pics
CORS_CREDENTIALS=false
TRUST_PROXY=false
ENABLE_API_DOCS=true
ENABLE_EMAIL_TEST_ENDPOINT=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
MUTATION_RATE_LIMIT_WINDOW_MS=60000
MUTATION_RATE_LIMIT_MAX=60
WEEKLY_CONTEST_AUTOMATION_ENABLED=true
WEEKLY_CONTEST_CHECK_INTERVAL_MS=3600000
HTTP_BODY_LIMIT=1mb
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES=1
UPLOAD_MAX_FIELDS=10
UPLOAD_MAX_FIELD_SIZE_BYTES=65536
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_ALLOW_INSECURE_LOCAL=true
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=
SMTP_FROM=no-reply@snapnation.local
